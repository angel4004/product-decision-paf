          "$ref": "#/$defs/nextStep"
        },
        "relations": {
          "$ref": "#/$defs/relations"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "closed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "verdict": {
                "enum": [
                  "confirmed",
                  "disconfirmed",
                  "unresolved"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "cancelled",
                  "superseded"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "verdict": {
                "const": "not_run"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "framing",
                  "blocked_upstream",
                  "awaiting_owner_rule",
                  "ready_to_run",
                  "running",
                  "ready_for_review"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "verdict": {
                "const": "pending"
              }
            }
          }
        }
      ]
    }
