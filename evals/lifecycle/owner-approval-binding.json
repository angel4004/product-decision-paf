  "turns": [
    {
      "turn_id": "checkpoint-pending-rule",
      "fresh_context": true,
      "input": "The model proposed a threshold, sample, and time window. The decision owner has not approved them.",
      "host_state": {
        "workspace_revision": null,
        "hypothesis_revision": null,
        "receipt_status": "missing",
        "workspace_id": "workspace-owner-binding",
        "hypothesis_id": "hypothesis-owner-binding",
        "decision_scope_id": "scope-initial",
        "owner_ref": "owner:decision",
        "owner_tenure_id": "tenure-old",
        "proposed_subject": {
          "metrics": [
            {
              "metric_id": "metric-activation",
              "criterion": "conversion_rate >= 0.40",
              "criterion_provenance": "proposed_assumption"
            }
          ],
          "sample": {
            "population": "eligible_accounts",
            "target_size": 100,
            "inclusion": [
